.{
    .color = .auto,
    .utc_offset_minutes = 0,
    .layout = .{
        .timestamp = .time,
        .show_level = true,
        .scope = .non_default,
        .separator = "  ",
        .scope_open = "[",
        .scope_close = "]",
        .level_width = 5,
    },
    .labels = .{
        .err = "ERROR",
        .warn = "WARN",
        .info = "INFO",
        .debug = "DEBUG",
    },
    .theme = .{
        .timestamp = .{
            .foreground = .{ .rgb = .{ .r = 105, .g = 112, .b = 134 } },
        },
        .err = .{
            .foreground = .{ .rgb = .{ .r = 255, .g = 92, .b = 117 } },
            .effects = .{.bold},
        },
        .warn = .{
            .foreground = .{ .rgb = .{ .r = 255, .g = 203, .b = 107 } },
            .effects = .{.bold},
        },
        .info = .{
            .foreground = .{ .rgb = .{ .r = 99, .g = 213, .b = 255 } },
            .effects = .{.bold},
        },
        .debug = .{
            .foreground = .{ .rgb = .{ .r = 199, .g = 146, .b = 234 } },
            .effects = .{.bold},
        },
        .scope = .{
            .foreground = .{ .rgb = .{ .r = 130, .g = 139, .b = 165 } },
        },
    },
    .message_format = .{
        .styles = .{
            .{
                .name = "brand",
                .style = .{
                    .foreground = .{ .rgb = .{ .r = 142, .g = 110, .b = 255 } },
                    .effects = .{.bold},
                },
            },
            .{
                .name = "success",
                .style = .{
                    .foreground = .{ .rgb = .{ .r = 80, .g = 250, .b = 123 } },
                    .effects = .{.bold},
                },
            },
            .{
                .name = "value",
                .style = .{
                    .foreground = .{ .rgb = .{ .r = 255, .g = 184, .b = 108 } },
                    .effects = .{.bold},
                },
            },
            .{
                .name = "muted",
                .style = .{
                    .foreground = .{ .rgb = .{ .r = 98, .g = 104, .b = 128 } },
                },
            },
        },
    },
}
